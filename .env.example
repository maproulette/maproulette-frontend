VITE_APP_NAME="MapRoulette"
VITE_APP_DESCRIPTION="MapRoulette 4 Local Development Environment"
VITE_API_BASE_URL="https://maproulette.org"
VITE_SERVER_API_KEY=""
VITE_NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
# Base URL for short links embedded in OSM changeset comments
# (e.g. https://mpr.lt/c/<challengeId>/t/<taskId>). If unset,
# short links will be omitted from changeset comments.
VITE_SHORT_URL="https://mpr.lt"
# External editors opened from a task
VITE_ID_EDITOR_SERVER_URL="https://www.openstreetmap.org/edit"
VITE_RAPID_EDITOR_SERVER_URL="https://rapideditor.org/edit"
VITE_LEVEL0_EDITOR_SERVER_URL="https://level0.osmz.ru/index.php"
# Root URL of the documentation site linked to from the app (see
# src/lib/docs.ts). Defaults to the public docs site when unset.
VITE_DOCS_BASE_URL="https://learn.maproulette.org"
# Comma-separated URLs of plugin bundles to auto-load at login (e.g. maproulette-review)
# VITE_DEPLOYMENT_PLUGIN_URLS="http://localhost:4201/maprouletteReviewPlugin.js"
