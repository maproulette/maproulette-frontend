{
  "name": "maproulette",
  "version": "4.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "postinstall": "test -f .env || cp .env.example .env",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc",
    "lint": "biome lint",
    "lint:fix": "biome lint --unsafe --write",
    "format": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=true --write",
    "check": "tsc && biome check",
    "check:fix": "tsc && biome check --write",
    "check:force": "tsc && biome check --write --unsafe",
    "generate:api-types": "openapi-typescript http://localhost:9000/assets/swagger.json -o src/types/openApiTypes.ts && npm run format -- src/types/openApiTypes.ts",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs && npm run format -- src/styles/tokens.gen.css src/styles/tokens.gen.ts",
    "explore": "vite-bundle-visualizer",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "i18n:extract": "node scripts/extractMessages.mjs",
    "i18n:push": "tx push -s",
    "i18n:pull": "tx pull -a --minimum-perc=50 && npm run format -- src/i18n/messages",
    "i18n:status": "tx status"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@types/supercluster": "^7.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "intl-messageformat": "^12.1.2",
    "ky": "^2.1.0",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-map-gl": "^8.1.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-use-websocket": "^4.13.0",
    "remark-breaks": "^4.0.0",
    "sonner": "^2.0.8",
    "supercluster": "^9.1.0",
    "tailwind-merge": "^3.7.0",
    "terra-draw": "^1.35.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "1.132.31",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.4",
    "happy-dom": "^20.14.5",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "storybook-dark-mode": "^5.0.0",
    "style-dictionary": "^5.5.5",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.2"
  }
}
